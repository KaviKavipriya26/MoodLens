# Copy this file to ".env" (same folder as manage.py) and fill in the values.

# MongoDB Atlas -> Connect -> Drivers -> copy the connection string.
# Replace <password> with your database-user password (URL-encode special characters like @ # / ).
MONGO_URI=mongodb+srv://questionpaper_user:ashwini1810@cluster0.piiam5j.mongodb.net/?appName=Cluster0
MONGO_DB=examforge

# Any long random string. Used to sign login tokens.
JWT_SECRET=change-this-to-a-long-random-string

# Timezone used for "today", streaks and daily dates.
APP_TZ=Asia/Kolkata

# Optional: lock CORS to your frontend (leave empty in development).
# FRONTEND_ORIGIN=http://localhost:5500

# Days of continuous negative mood before the trend alert shows.
TREND_ALERT_DAYS=7
